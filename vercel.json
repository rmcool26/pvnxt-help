{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(css|js|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "functions": {
    "api/chat.js": {
      "includeFiles": "js/data.js",
      "maxDuration": 20
    }
  }
}